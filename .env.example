# DeepSeek API Key：用于调用 DeepSeek LLM。到 https://platform.deepseek.com 申请后填入自己的 key。
# 注意：把真实 key 写进 .env（已被 gitignore），绝不要写进本示例文件或任何会提交的文件。
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# HuggingFace 离线模式：0 表示允许联网下载模型，1 表示只使用本地缓存。
HF_HUB_OFFLINE=0

# LangChain tracing 开关：false 表示默认不启用链路追踪。
LANGCHAIN_TRACING_V2=false
